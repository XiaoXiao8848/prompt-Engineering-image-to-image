# ==========================================
# Prompt Engine — 环境变量配置模板
# 复制为 .env 并填入实际值
# ==========================================

# === 应用 ===
APP_NAME=Prompt Engine
DEBUG=false
ENV=development

# === MySQL 数据库 ===
# 格式: mysql+asyncmy://user:password@host:port/database
DATABASE_URL=mysql+asyncmy://root:rootpass@localhost:3306/prompt_engine
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === LLM (DeepSeek / OpenAI) ===
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# === JWT 认证 ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

# === 限流 ===
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_API_KEY=1000

# === 文件存储 (MinIO / S3) ===
# STORAGE_TYPE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=prompt-engine
# S3_REGION=us-east-1
